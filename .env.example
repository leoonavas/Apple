# Supabase project values. Publishable keys are safe for the browser; never add the service role key here with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_server_only_replace_me
RESEND_API_KEY=re_replace_with_a_server_only_key
MIGRATION_EMAIL=owner@example.com

# Random secret for authenticating the Windows worker to internal job endpoints.
WORKER_TOKEN=replace-with-a-random-64-character-secret
WORKER_URL=https://app.arcadya.cc
NEXT_PUBLIC_APP_URL=https://app.arcadya.cc
NEXT_PUBLIC_PRIVACY_EMAIL=

# Optional: override the default local model and paths.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
WHISPER_MODEL=./models/ggml-medium-q5_0.bin
APP_DATA_DIR=./.data
